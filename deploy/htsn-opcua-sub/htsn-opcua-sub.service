[Unit]
Description=HTSN OPC UA subscription client (drives PublishRequest/Response on lo for Wireshark)
After=network-online.target htsn-cnc.service
Wants=htsn-cnc.service

[Service]
Type=simple
User=wtsn
Group=wtsn
WorkingDirectory=/home/wtsn
Environment=HOME=/home/wtsn
Environment=HTSN_OPCUA_URL=opc.tcp://127.0.0.1:4840
ExecStart=/usr/bin/python3 /home/wtsn/htsn-opcua-sub/htsn_sub_client.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
