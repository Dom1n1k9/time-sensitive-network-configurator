  {"id":"FN_DEVFMT","type":"function","z":"FLOWTAB","name":"fmt devices","func":"var rows=msg.payload||[];var out=rows.map(function(r){var st=(r.status===0)?'online':'offline';return{id:r.id||'',name:r.name||'',ip:r.ip||'',st:st,dom:r.domain||'default',fw:r.firmware||'',usb:r.usb||''};});global.set('HTSN_DEVICES',out);return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":480,"y":820,"wires":[["T_DEV"]]},
  {"id":"T_DEV","type":"ui_table","z":"FLOWTAB","group":"GRP_DEV","name":"devices","width":"12","height":"10","collapse":false,"tableLayout":"fixed","hoverable":true,"sortable":true,"storeFirstRows":false,"defaultSort":{"property":"id","direction":"asc"},"columns":[{"alias":"id","property":"id","type":"text","width":"15%","layout":"left"},{"alias":"name","property":"name","type":"text","width":"15%","layout":"left"},{"alias":"ip","property":"ip","type":"text","width":"15%","layout":"left"},{"alias":"status","property":"st","type":"text","width":"10%","layout":"center"},{"alias":"domain","property":"dom","type":"text","width":"15%","layout":"left"},{"alias":"firmware","property":"fw","type":"text","width":"15%","layout":"left"},{"alias":"usb","property":"usb","type":"text","width":"15%","layout":"left"}],"layout":"row","x":680,"y":820,"wires":[]},

