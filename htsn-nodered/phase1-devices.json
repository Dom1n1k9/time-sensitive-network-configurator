  {"id":"FN_PINGR","type":"function","z":"FLOWTAB","name":"ping result","func":"var did=msg.topic||'';var t0=Date.now();var ok=true;var note='';if(err){ok=false;note=err.message||String(err);}else if(msg.responseCode&&msg.responseCode!==200){ok=false;note='HTTP '+msg.responseCode;}node.status({fill:ok?'green':'red',text:ok?'online':'offline'});return {payload:did+': '+(ok?'online':'offline '+(note||''))};","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":860,"y":960,"wires":[["T_PING"]]},
