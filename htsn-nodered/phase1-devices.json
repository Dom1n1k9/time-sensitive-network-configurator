  {
    "id": "FN_ADD",
    "type": "function",
    "z": "FLOWTAB",
    "name": "build add SQL",
    "func": "function embedParams(sql,params){if(!params)return sql;params=params.slice();for(var i=0;i<params.length;i++){var idx=sql.indexOf('?');if(idx<0)break;var v=params[i];var ev;if(v===null){ev='NULL';}else if(typeof v==='boolean'){ev=v?'1':'0';}else if(typeof v==='number'){ev=String(v);}else{ev=\"'\"+String(v).replace(/'/g,\"''\")+\"'\";}sql=sql.substring(0,idx)+ev+sql.substring(idx+1);}return sql;}\nvar f=msg.payload||{};var id=f.id||'';if(!id){node.status({fill:'red',text:'no id'});return null;}msg.topic='INSERT OR REPLACE INTO devices(id,name,ip,mac,kind,firmware,status,last_seen,domain,usb) VALUES(?,?,?,?,0,?,0,strftime(\\'%s\\',\\'now\\'),?,?)';msg.params=[id,f.name||'',f.ip||'','',f.domain||'default',f.usb||''];msg.topic=embedParams(msg.topic,msg.params);return msg;",
    "outputs": 1,
    "timeout": 0,
