    "sql": "SELECT id,name,ip,mac,kind,firmware,status,last_seen,domain,usb FROM devices ORDER BY id"
  },
  {
    "id": "FN_DEVFMT",
    "type": "function",
    "z": "FLOWTAB",
    "name": "fmt devices",
    "func": "var rows=msg.payload||[];var out=rows.map(function(r){var st=(r.status===0)?'online':'offline';return{id:r.id||'',name:r.name||'',ip:r.ip||'',st:st,dom:r.domain||'default',fw:r.firmware||'',usb:r.usb||''};});global.set('HTSN_DEVICES',out);return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 480,
    "y": 820,
    "wires": [
      [
        "T_DEV"
      ]
    ]
  },
  {
    "id": "T_DEV",
    "type": "ui_template",
    "z": "FLOWTAB",
    "group": "GRP_DEV",
    "name": "devices",
    "width": "12",
    "height": "10",
    "x": 680,
    "y": 820,
    "wires": [],
    "html": "<div style=\"overflow:auto;max-height:100%\">\n<table style=\"width:100%;border-collapse:collapse;font-size:12px\" id=\"tbl_{id}\">\n<thead><tr><th>id</th><th>name</th><th>ip</th><th>status</th><th>domain</th><th>firmware</th><th>usb</th></tr></thead>\n<tbody id=\"tbody_{id}\"></tbody>\n</table>\n</div>\n<script>\n(function(){\n  var tblId='tbl_{id}';\n  var cols=[\"id\", \"name\", \"ip\", \"st\", \"dom\", \"fw\", \"usb\"];\n  function render(){\n    var rows=(msg&&msg.payload)||[];\n    var tbody=document.getElementById('tbody_'+tblId);\n    if(!tbody)return;\n    tbody.innerHTML='';\n    rows.forEach(function(r){\n      var tr=document.createElement('tr');\n      tr.style.borderBottom='1px solid #eee';\n      cols.forEach(function(p){\n        var td=document.createElement('td');\n        td.style.padding='4px 6px';\n        var v=r[p];\n        td.textContent=(v===null||v===undefined)?'-':String(v);\n        tr.appendChild(td);\n      });\n      tbody.appendChild(tr);\n    });\n    if(rows.length===0){\n      var tr=document.createElement('tr');\n      var td=document.createElement('td');\n      td.colSpan=cols.length;\n      td.style.textAlign='center';\n      td.style.color='#999';\n      td.textContent='No data';\n      tr.appendChild(td);\n      tbody.appendChild(tr);\n    }\n  }\n  render();\n})();\n</script>",
    "format": "{{msg.payload}}",
    "storeOutMessages": true,
    "fgColor": "#000000",
    "bgColor": "#ffffff",
    "className": ""
  },
