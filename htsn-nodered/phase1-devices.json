  {"id":"FN_VSN","type":"function","z":"FLOWTAB","name":"build snapshot","func":"var tables=['devices','qos_configs','preemption_configs','vlan_groups','vlan_members','tas_schedules','gcl_entries','timesync_status','tsn_streams','tsn_stream_members','settings'];msg.topic='snapshot-'+new Date().toTimeString().substring(0,8).replace(/:/g,'');msg.query='SELECT name FROM sqlite_master WHERE type=\\'table\\' AND name IN (\\''+tables.join('\\',\\''+\\')+'\\')';return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":300,"y":1060,"wires":[["SQL_VSNQ"]]},
  {"id":"SQL_VSNQ","type":"sqlite","z":"FLOWTAB","name":"list tables","operation":"query","query":"{{msg.query}}","failOnErr":false,"database":"SQLCFG","x":480,"y":1060,"wires":[["FN_VSN2"]]},
  {"id":"FN_VSN2","type":"function","z":"FLOWTAB","name":"snapshot data","func":"var tables=(msg.payload||[]).map(function(r){return r.name||r[0];});var results={};var pending=tables.length;if(!pending){global.set('HTSN_VSN',JSON.stringify(results));return {payload:'snapshot saved (empty)'};}tables.forEach(function(t){global.set('HTSN_VSN_'+t,null);});msg.query='SELECT * FROM devices';msg._tables=tables;msg._idx=0;return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":660,"y":1060,"wires":[["SQL_VSNR"]]},
  {"id":"SQL_VSNR","type":"sqlite","z":"FLOWTAB","name":"read table","operation":"query","query":"{{msg.query}}","failOnErr":false,"database":"SQLCFG","x":840,"y":1060,"wires":[["FN_VSN3"]]},
  {"id":"FN_VSN3","type":"function","z":"FLOWTAB","name":"collect + save","func":"var tables=msg._tables||[];var idx=msg._idx||0;var t=tables[idx];if(t){global.set('HTSN_VSN_'+t,msg.payload||[]);}idx++;if(idx<tables.length){msg._idx=idx;msg.query='SELECT * FROM '+tables[idx];return msg;}var snap={};tables.forEach(function(t){snap[t]=global.get('HTSN_VSN_'+t)||[];});var name=msg.topic||'snapshot';msg.query='INSERT INTO config_versions(name,device_id,created_at,payload) VALUES(?,?,?,?)';msg.params=[name,'',Math.floor(Date.now()/1000),JSON.stringify(snap)];node.status({fill:'green',text:'saved '+name});return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":1020,"y":1060,"wires":[["SQL_VSNW"]]},
