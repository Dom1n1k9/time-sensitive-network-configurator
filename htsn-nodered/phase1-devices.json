  {"id":"FN_ADD","type":"function","z":"FLOWTAB","name":"build add SQL","func":"var f=msg.payload||{};var id=f.id||'';if(!id){node.status({fill:'red',text:'no id'});return null;}msg.query='INSERT OR REPLACE INTO devices(id,name,ip,mac,kind,firmware,status,last_seen,domain,usb) VALUES(?,?,?,?,0,?,0,strftime(\\'%s\\',\\'now\\'),?,?)';msg.params=[id,f.name||'',f.ip||'','',f.domain||'default',f.usb||''];return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":300,"y":900,"wires":[["SQL_ADD"]]},
