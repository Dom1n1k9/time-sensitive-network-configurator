  {"id":"INJ_PING","type":"ui_button","z":"FLOWTAB","group":"GRP_ADD","name":"ping","label":"Ping selected","group":"GRP_ADD","order":2,"width":"6","height":"1","color":"","bgcolor":"","payload":"ping","payloadType":"str","topic":"","topicType":"str","x":100,"y":960,"wires":[["FN_PING"]]},
  {"id":"FN_PING","type":"function","z":"FLOWTAB","name":"ping logic","func":"var devs=global.get('HTSN_DEVICES')||[];var did=msg.topic||'';if(!did){var sel=global.get('HTSN_SEL_DEV');if(sel){did=sel;}}if(!did||!devs.length){node.status({fill:'red',text:'no device'});return null;}var dev=devs.find(function(d){return d.id===did;});if(!dev){node.status({fill:'red',text:'not found'});return null;}var isCam=/cam/i.test(dev.id)||dev.id.indexOf('cam')>=0;msg.payload={id:did,ip:dev.ip,isCam:isCam,ts:Date.now()};return msg;","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":300,"y":960,"wires":[["HTTP_PING"],["MQ_PING"]]},
  {"id":"HTTP_PING","type":"http request","z":"FLOWTAB","name":"cam ping","method":"GET","ret":"txt","paytoqs":false,"url":"http://{{msg.payload.ip}}/last.jpg","tls":"","persist":false,"proxy":"","authType":"","senderr":true,"headers":[],"x":500,"y":940,"wires":[["FN_PINGR"]]},
  {"id":"MQ_PING","type":"mqtt out","z":"FLOWTAB","name":"mqtt ping","topic":"tsn/cmd/{{msg.payload.id}}/ping","qos":"0","retain":"false","respTopic":"","contentType":"","broker":"BRK1","x":500,"y":980,"wires":[["FN_PINGR"]]},
  {"id":"FN_PINGR","type":"function","z":"FLOWTAB","name":"ping result","func":"var p=global.get('HTSN_PING_OUT')||{};var did=msg.payload&&msg.payload.id?msg.payload.id:(msg.topic||'').split('/').pop();var t0=p[did]||Date.now();var rtt=Date.now()-t0;var ok=(err===undefined&&!msg.responseCode)||msg.responseCode===200;node.status({fill:ok?'green':'red',text:ok?'online '+rtt+'ms':'offline'});global.set('HTSN_PING_OUT',Object.assign(p,{[did]:t0}));return {payload:did+': '+(ok?'online ('+rtt+'ms)':'offline')};","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":700,"y":960,"wires":[["T_PING"]]},
