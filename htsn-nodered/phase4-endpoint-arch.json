  {"id":"T_ARCH","type":"ui_template","z":"FLOWTAB","group":"GRP_EPARCH","order":0,"width":"12","height":"20","name":"topology","label":"Network topology","html":"<div style='width:100%;height:100%;overflow:auto'><svg id='archsvg' width='100%' height='500'></svg></div><script>function drawArch(){var svg=document.getElementById('archsvg');if(!svg)return;var devs=msg.__devices||[];var streams=msg.__streams||[];svg.innerHTML='';var W=svg.clientWidth||800,H=500;var cx=W/2,cy=50;function el(tag,attrs){var e=document.createElementNS('http://www.w3.org/2000/svg',tag);for(var k in attrs)e.setAttribute(k,attrs[k]);return e;}svg.appendChild(el('rect',{x:cx-80,y:cy-20,width:160,height:40,rx:8,fill:'#3498db',stroke:'#2980b9','stroke-width':2}));var t=el('text',{x:cx,y:cy+5,'text-anchor':'middle','font-size':'12',fill:'#fff'});t.textContent='CNC (RPi)';svg.appendChild(t);devs.forEach(function(d,i){var col=Math.floor(i/3),row=i%3;var x=80+col*200,y=150+row*120;svg.appendChild(el('line',{x1:cx,y1:cy+20,x2:x,y2:y,stroke:d.st==='online'?'#2ecc71':'#e74c3c','stroke-width':2}));svg.appendChild(el('rect',{x:x-60,y:y-15,width:120,height:30,rx:6,fill:d.st==='online'?'#2ecc71':'#e74c3c',opacity:0.8}));var txt=el('text',{x:x,y:y+4,'text-anchor':'middle','font-size':'10',fill:'#fff'});txt.textContent=d.id.substring(0,14);svg.appendChild(txt);});}</script><script>drawArch();</script>","format":"<h4>{{msg.payload}}</h4>","storeOutMessages":true,"fgColor":"#000000","bgColor":"#ffffff","className":"","x":100,"y":3200,"wires":[[]]},
