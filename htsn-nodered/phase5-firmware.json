  {"id":"SQL_FW","type":"sqlite","z":"FLOWTAB","name":"read firmware","operation":"query","query":"SELECT file,version,size,crc32,kind,uploaded_at FROM firmware ORDER BY uploaded_at DESC","failOnErr":false,"database":"SQLCFG","x":280,"y":3340,"wires":[["FN_FW"]]},
  {"id":"FN_FW","type":"function","z":"FLOWTAB","name":"fmt firmware","func":"var rows=(msg.payload||[]).map(function(r){var ts=r.uploaded_at?new Date(r.uploaded_at*1000).toLocaleString():'';var kb=r.size?Math.round(r.size/1024)+'KB':'';return{file:r.file||'',ver:r.version||'',size:kb,crc:r.crc32||'',kind:r.kind>=0?r.kind:'any',ts:ts};});global.set('HTSN_FIRMWARE',rows);return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":480,"y":3340,"wires":[["T_FW"]]},
  {"id":"T_FW","type":"ui_table","z":"FLOWTAB","group":"GRP_FWLIST","name":"firmware","width":"12","height":"8","collapse":false,"tableLayout":"fixed","hoverable":true,"sortable":true,"storeFirstRows":false,"defaultSort":{"property":"ts","direction":"desc"},"columns":[{"alias":"file","property":"file","type":"text","width":"25%","layout":"left"},{"alias":"version","property":"ver","type":"text","width":"12%","layout":"left"},{"alias":"size","property":"size","type":"text","width":"10%","layout":"right"},{"alias":"crc32","property":"crc","type":"text","width":"12%","layout":"left"},{"alias":"kind","property":"kind","type":"text","width":"8%","layout":"center"},{"alias":"uploaded","property":"ts","type":"text","width":"33%","layout":"left"}],"layout":"row","x":680,"y":3340,"wires":[]},

  {"id":"HTTP_FWUP","type":"http in","z":"FLOWTAB","name":"fw upload","url":"/api/fw-upload","method":"post","upload":true,"swaggerTag":"","x":100,"y":3420,"wires":[["FN_FWUP"]]},
  {"id":"FN_FWUP","type":"function","z":"FLOWTAB","name":"process upload","func":"var fname=msg.req.headers['x-filename']||'firmware.bin';var fkind=msg.req.headers['x-device']||'-1';if(!msg.payload){return null;}var data=Buffer.isBuffer(msg.payload)?msg.payload:Buffer.from(msg.payload);var size=data.length;var crc=(function(b){var c=0xFFFFFFFF;for(var i=0;i<b.length;i++){c^=b[i];for(var j=0;j<8;j++){c=(c>>>1)^(0xEDB88320&-(c&1));}}return('00000000'+((c^0xFFFFFFFF)>>>0).toString(16)).slice(-8);})(data);var ver=(fname.match(/v?(\\d+\\.\\d+\\.\\d+)/)||[])[1]||'';msg.query='INSERT OR REPLACE INTO firmware(file,version,size,crc32,kind,uploaded_at) VALUES(?,?,?,?,?,?)';msg.params=[fname,ver,size,crc,parseInt(fkind)||-1,Math.floor(Date.now()/1000)];msg._fname=fname;msg._data=data;msg._fwdir='/home/wtsn/wtsn-configurator/build/fw';return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":300,"y":3420,"wires":[["SQL_FWUP"]]},
  {"id":"SQL_FWUP","type":"sqlite","z":"FLOWTAB","name":"save fw meta","operation":"insert","query":"{{msg.query}}","failOnErr":true,"database":"SQLCFG","x":500,"y":3420,"wires":[["EXE_FWUP"]]},
  {"id":"EXE_FWUP","type":"exec","z":"FLOWTAB","name":"write fw file","command":"mkdir -p {{msg._fwdir}} && echo ok","addpay":true,"append":"","useSpawn":false,"timer":"","oldmode":false,"defer":false,"x":700,"y":3420,"wires":[["T_FWUP","",""]]},
  {"id":"T_FWUP","type":"ui_text","z":"FLOWTAB","group":"GRP_FWUP","order":0,"width":"6","label":"Upload","format":"Firmware uploaded","layout":"row-spread","style":"","font":"","fontSize":"14","color":"#00b500","x":900,"y":3420,"wires":[]},

  {"id":"SEL_FWDEV","type":"ui_dropdown","z":"FLOWTAB","group":"GRP_FWFLASH","order":0,"width":"6","name":"flash dev","label":"Device to flash","tooltip":"","options":[{"name":"esp32-01","value":"esp32-01","type":"str"},{"name":"esp32-cam","value":"esp32-cam","type":"str"}],"optionType":"enum","hasType":false,"passthrow":true,"deployOnInputChange":false,"className":"","x":100,"y":3500,"wires":[["FN_FLASH"]]},
  {"id":"FN_FLASH","type":"function","z":"FLOWTAB","name":"flash cmd","func":"var did=msg.payload||'';if(!did){return null;}var fws=global.get('HTSN_FIRMWARE')||[];if(!fws.length){node.status({fill:'red',text:'no firmware'});return null;}var fw=fws[0];var host='192.168.0.183';var url='http://'+host+':8000/fw/'+fw.file;msg.topic='tsn/cmd/'+did+'/ota';msg.payload=JSON.stringify({url:url,crc32:fw.crc,version:fw.ver});node.status({fill:'blue',text:'OTA '+did});return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":300,"y":3500,"wires":[["MQ_FLASH"]]},
  {"id":"MQ_FLASH","type":"mqtt out","z":"FLOWTAB","name":"ota cmd","topic":"{{msg.topic}}","qos":"0","retain":"false","respTopic":"","contentType":"","broker":"BRK1","x":500,"y":3500,"wires":[["T_FLASH"]]},
  {"id":"T_FLASH","type":"ui_text","z":"FLOWTAB","group":"GRP_FWFLASH","order":1,"width":"6","label":"OTA","format":"OTA started","layout":"row-spread","style":"","font":"","fontSize":"14","color":"#00b500","x":700,"y":3500,"wires":[]}
