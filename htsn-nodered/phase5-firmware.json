  {
    "id": "SQL_FW",
    "type": "sqlite",
    "z": "FLOWTAB",
    "name": "read firmware",
    "x": 280,
    "y": 3340,
    "wires": [
      [
        "FN_FW"
      ]
    ],
    "mydb": "SQLCFG",
    "sqlquery": "fixed",
    "sql": "SELECT file,version,size,crc32,kind,uploaded_at FROM firmware ORDER BY uploaded_at DESC"
  },
  {
    "id": "FN_FW",
    "type": "function",
    "z": "FLOWTAB",
    "name": "fmt firmware",
    "func": "var rows=(msg.payload||[]).map(function(r){var ts=r.uploaded_at?new Date(r.uploaded_at*1000).toLocaleString():'';var kb=r.size?Math.round(r.size/1024)+'KB':'';return{file:r.file||'',ver:r.version||'',size:kb,crc:r.crc32||'',kind:r.kind>=0?r.kind:'any',ts:ts};});global.set('HTSN_FIRMWARE',rows);return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 480,
    "y": 3340,
    "wires": [
      [
        "T_FW"
      ]
    ]
  },
  {
    "id": "T_FW",
    "type": "ui_template",
    "z": "FLOWTAB",
    "group": "GRP_FWLIST",
    "name": "firmware",
    "width": "12",
    "height": "8",
    "x": 680,
    "y": 3340,
    "wires": [],
    "html": "<div style=\"overflow:auto;max-height:100%\">\n<table style=\"width:100%;border-collapse:collapse;font-size:12px\" id=\"tbl_{id}\">\n<thead><tr><th>file</th><th>version</th><th>size</th><th>crc32</th><th>kind</th><th>uploaded</th></tr></thead>\n<tbody id=\"tbody_{id}\"></tbody>\n</table>\n</div>\n<script>\n(function(){\n  var tblId='tbl_{id}';\n  var cols=[\"file\", \"ver\", \"size\", \"crc\", \"kind\", \"ts\"];\n  function render(){\n    var rows=(msg&&msg.payload)||[];\n    var tbody=document.getElementById('tbody_'+tblId);\n    if(!tbody)return;\n    tbody.innerHTML='';\n    rows.forEach(function(r){\n      var tr=document.createElement('tr');\n      tr.style.borderBottom='1px solid #eee';\n      cols.forEach(function(p){\n        var td=document.createElement('td');\n        td.style.padding='4px 6px';\n        var v=r[p];\n        td.textContent=(v===null||v===undefined)?'-':String(v);\n        tr.appendChild(td);\n      });\n      tbody.appendChild(tr);\n    });\n    if(rows.length===0){\n      var tr=document.createElement('tr');\n      var td=document.createElement('td');\n      td.colSpan=cols.length;\n      td.style.textAlign='center';\n      td.style.color='#999';\n      td.textContent='No data';\n      tr.appendChild(td);\n      tbody.appendChild(tr);\n    }\n  }\n  render();\n})();\n</script>",
    "format": "{{msg.payload}}",
    "storeOutMessages": true,
    "fgColor": "#000000",
    "bgColor": "#ffffff",
    "className": ""
  },
  {
    "id": "HTTP_FWUP",
    "type": "http in",
    "z": "FLOWTAB",
    "name": "fw upload",
    "url": "/api/fw-upload",
    "method": "post",
    "upload": true,
    "swaggerTag": "",
    "x": 100,
    "y": 3420,
    "wires": [
      [
        "FN_FWUP"
      ]
    ]
  },
  {
    "id": "FN_FWUP",
    "type": "function",
    "z": "FLOWTAB",
    "name": "process upload",
    "func": "function embedParams(sql,params){if(!params)return sql;params=params.slice();for(var i=0;i<params.length;i++){var idx=sql.indexOf('?');if(idx<0)break;var v=params[i];var ev;if(v===null){ev='NULL';}else if(typeof v==='boolean'){ev=v?'1':'0';}else if(typeof v==='number'){ev=String(v);}else{ev=\"'\"+String(v).replace(/'/g,\"''\")+\"'\";}sql=sql.substring(0,idx)+ev+sql.substring(idx+1);}return sql;}\nvar fname=msg.req.headers['x-filename']||'firmware.bin';var fkind=msg.req.headers['x-device']||'-1';if(!msg.payload){return null;}var data=Buffer.isBuffer(msg.payload)?msg.payload:Buffer.from(msg.payload);var size=data.length;var crc=(function(b){var c=0xFFFFFFFF;for(var i=0;i<b.length;i++){c^=b[i];for(var j=0;j<8;j++){c=(c>>>1)^(0xEDB88320&-(c&1));}}return('00000000'+((c^0xFFFFFFFF)>>>0).toString(16)).slice(-8);})(data);var ver=(fname.match(/v?(\\d+\\.\\d+\\.\\d+)/)||[])[1]||'';msg.topic='INSERT OR REPLACE INTO firmware(file,version,size,crc32,kind,uploaded_at) VALUES(?,?,?,?,?,?)';msg.params=[fname,ver,size,crc,parseInt(fkind)||-1,Math.floor(Date.now()/1000)];msg._fname=fname;msg._data=data;msg._fwdir='/home/wtsn/wtsn-configurator/build/fw';msg.topic=embedParams(msg.topic,msg.params);return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 300,
    "y": 3420,
    "wires": [
      [
        "SQL_FWUP"
      ]
    ]
  },
