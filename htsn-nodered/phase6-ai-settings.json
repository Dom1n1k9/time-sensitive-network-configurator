  {
    "id": "FN_SET",
    "type": "function",
    "z": "FLOWTAB",
    "name": "save settings",
    "func": "function embedParams(sql,params){if(!params)return sql;params=params.slice();for(var i=0;i<params.length;i++){var idx=sql.indexOf('?');if(idx<0)break;var v=params[i];var ev;if(v===null){ev='NULL';}else if(typeof v==='boolean'){ev=v?'1':'0';}else if(typeof v==='number'){ev=String(v);}else{ev=\"'\"+String(v).replace(/'/g,\"''\")+\"'\";}sql=sql.substring(0,idx)+ev+sql.substring(idx+1);}return sql;}\nvar f=msg.payload||{};if(f.broker){msg.topic='INSERT OR REPLACE INTO settings(key,value) VALUES(\\'broker\\',?)';msg.params=[f.broker];}else if(f.llm_url){msg.topic='INSERT OR REPLACE INTO settings(key,value) VALUES(\\'llm_url\\',?)';msg.params=[f.llm_url];}else{return null;}msg.topic=embedParams(msg.topic,msg.params);return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 300,
    "y": 3820,
    "wires": [
