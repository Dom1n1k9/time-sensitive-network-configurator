        "HTTP_LLM"
      ]
    ]
  },
  {
    "id": "HTTP_LLM",
    "type": "http request",
    "z": "FLOWTAB",
    "name": "LLM bridge",
    "method": "POST",
    "ret": "obj",
    "paytoqs": false,
    "url": "http://127.0.0.1:8081/chat",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "senderr": true,
    "headers": [
