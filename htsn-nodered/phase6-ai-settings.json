  {"id":"SQL_DECI","type":"sqlite","z":"FLOWTAB","name":"read decisions","operation":"query","query":"SELECT ts,device_id,action,params,reason,source FROM ai_decisions ORDER BY id DESC LIMIT 50","failOnErr":false,"database":"SQLCFG","x":280,"y":3680,"wires":[["FN_DECI"]]},
  {"id":"FN_DECI","type":"function","z":"FLOWTAB","name":"fmt decisions","func":"var rows=(msg.payload||[]).map(function(r){var ts=r.ts?new Date(r.ts*1000).toLocaleTimeString():'';return{ts:ts,dev:r.device_id||'',act:r.action||'',src:r.source||'',reason:(r.reason||'').substring(0,60)};});return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":480,"y":3680,"wires":[["T_DECI"]]},
