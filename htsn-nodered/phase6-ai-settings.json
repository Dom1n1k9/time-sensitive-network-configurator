  {"id":"FN_CHAT","type":"function","z":"FLOWTAB","name":"build LLM request","func":"var f=msg.payload||{};var m=f.message||'';if(!m){return null;}node.status({fill:'blue',text:'thinking...'});msg.payload={message:m,history:[]};return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":300,"y":3600,"wires":[["HTTP_LLM"]]},
  {"id":"HTTP_LLM","type":"http request","z":"FLOWTAB","name":"LLM bridge","method":"POST","ret":"obj","paytoqs":false,"url":"http://127.0.0.1:8081/chat","tls":"","persist":false,"proxy":"","authType":"","senderr":true,"headers":[{"name":"Content-Type","value":"application/json"}],"x":480,"y":3600,"wires":[["FN_CHATR"]]},
  {"id":"FN_CHATR","type":"function","z":"FLOWTAB","name":"parse LLM reply","func":"var r=msg.payload||{};var txt=r.response||r.reply||r.message||JSON.stringify(r);var act=r.action||'';node.status({fill:'green',text:act?'action: '+act:'guide'});return {payload:txt+(act?'\n\n[action: '+act+']':'')};","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":660,"y":3600,"wires":[["T_CHAT"]]},
