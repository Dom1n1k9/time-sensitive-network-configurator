  {"id":"FN_SET","type":"function","z":"FLOWTAB","name":"save settings","func":"var f=msg.payload||{};if(f.broker){msg.query='INSERT OR REPLACE INTO settings(key,value) VALUES(\\'broker\\',?)';msg.params=[f.broker];}else if(f.llm_url){msg.query='INSERT OR REPLACE INTO settings(key,value) VALUES(\\'llm_url\\',?)';msg.params=[f.llm_url];}else{return null;}return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":300,"y":3820,"wires":[["SQL_SET"]]},
