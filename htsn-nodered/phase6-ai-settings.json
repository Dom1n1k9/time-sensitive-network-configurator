  {
    "id": "FN_CHATR",
    "type": "function",
    "z": "FLOWTAB",
    "name": "parse LLM reply",
    "func": "var r=msg.payload||{};var txt=r.response||r.reply||r.message||JSON.stringify(r);var act=r.action||'';node.status({fill:'green',text:act?'action: '+act:'guide'});return {payload:txt+(act?'\n\n[action: '+act+']':'')};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
