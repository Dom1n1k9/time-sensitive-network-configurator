  {"id":"FORM_STM","type":"ui_form","z":"FLOWTAB","group":"GRP_STM","order":0,"width":6,"height":0,"name":"stream form","label":"TSN stream (802.1Qcc)","topic":"stream_save","topicType":"str","submit":"Save stream","cancel":"Reset","splitLayout":false,"className":"","options":[{"label":"Stream name","type":"text","name":"name","value":"stream1"},{"label":"Talker device","type":"text","name":"talker","value":"esp32-01"},{"label":"Listeners (comma-sep)","type":"text","name":"listeners","value":""},{"label":"VLAN ID","type":"number","name":"vlan_id","value":"100"}],"x":100,"y":1640,"wires":[["FN_STM"]]},
  {"id":"FN_STM","type":"function","z":"FLOWTAB","name":"stream SQL","func":"var f=msg.payload||{};var n=f.name||'';var t=f.talker||'';if(!n||!t){return null;}msg.query='INSERT OR REPLACE INTO tsn_streams(stream_id,name,talker,vlan_id,max_latency_ns,max_interval_ns,priority,data_frame_prio,status,comment) VALUES(?,?,?,?,100000000,1000000,5,5,0,\\'\\')';msg.params=[n,n,t,parseInt(f.vlan_id)||0];msg._listeners=(f.listeners||'').split(',').map(function(s){return s.trim();}).filter(Boolean);return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":300,"y":1640,"wires":[["SQL_STM"]]},
  {"id":"SQL_STM","type":"sqlite","z":"FLOWTAB","name":"write stream","operation":"insert","query":"{{msg.query}}","failOnErr":true,"database":"SQLCFG","x":480,"y":1640,"wires":[["FN_STMM"]]},
  {"id":"FN_STMM","type":"function","z":"FLOWTAB","name":"stream members","func":"var sid=msg._sid||'';var lsn=msg._listeners||[];msg.query='DELETE FROM tsn_stream_members WHERE stream_id=?';msg.params=[sid];return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":660,"y":1640,"wires":[["SQL_STMD"]]},
