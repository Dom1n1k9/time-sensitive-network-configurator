  {"id":"FORM_QOS","type":"ui_form","z":"FLOWTAB","group":"GRP_QOS","order":0,"width":6,"height":0,"name":"qos form","label":"QoS per device","topic":"qos_save","topicType":"str","submit":"Save QoS","cancel":"Reset","splitLayout":false,"className":"","options":[{"label":"Device ID","type":"text","name":"device_id","value":"esp32-01"},{"label":"Priority (0-7)","type":"number","name":"priority","value":"5"},{"label":"Traffic class (0-3)","type":"number","name":"traffic_class","value":"5"},{"label":"Bandwidth kbps","type":"number","name":"bandwidth_kbps","value":"1000"},{"label":"Latency ms","type":"number","name":"latency_ms","value":"100"},{"label":"Preemption (0-1)","type":"number","name":"preemption","value":"0"}],"x":100,"y":1200,"wires":[["FN_QOS"]]},
  {"id":"FN_QOS","type":"function","z":"FLOWTAB","name":"qos SQL","func":"var f=msg.payload||{};var d=f.device_id||'';if(!d){return null;}msg.query='INSERT OR REPLACE INTO qos_configs(device_id,priority,traffic_class,bandwidth_kbps,latency_ms,preemption) VALUES(?,?,?,?,?,?)';msg.params=[d,parseInt(f.priority)||0,parseInt(f.traffic_class)||0,parseInt(f.bandwidth_kbps)||0,parseInt(f.latency_ms)||0,parseInt(f.preemption)||0];return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":300,"y":1200,"wires":[["SQL_QOS"]]},
