  {"id":"SQL_VLANL","type":"sqlite","z":"FLOWTAB","name":"read vlans","operation":"query","query":"SELECT g.id,g.name,g.vlan_id, GROUP_CONCAT(m.device_id) as members FROM vlan_groups g LEFT JOIN vlan_members m ON m.group_id=g.id GROUP BY g.id ORDER BY g.vlan_id","failOnErr":false,"database":"SQLCFG","x":280,"y":1400,"wires":[["T_VLANL"]]},
