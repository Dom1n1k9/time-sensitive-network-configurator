  {"id":"FN_VLAN","type":"function","z":"FLOWTAB","name":"vlan SQL","func":"var f=msg.payload||{};var n=f.name||'';if(!n){return null;}var vid=Math.max(1,Math.min(4094,parseInt(f.vlan_id)||1));msg.query='INSERT OR REPLACE INTO vlan_groups(id,name,vlan_id) VALUES(?,?,?)';msg.params=['grp'+vid,n,vid];return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":300,"y":1340,"wires":[["SQL_VLAN"]]},
