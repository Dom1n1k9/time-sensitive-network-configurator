  {"id":"FN_DEPLOY","type":"function","z":"FLOWTAB","name":"build deploy","func":"var devs=global.get('HTSN_DEVICES')||[];if(!devs.length){node.status({fill:'red',text:'no devices'});return null;}var results=[];devs.forEach(function(d){var topic='tsn/cmd/'+d.id+'/apply';var payload={device_id:d.id};results.push({topic:topic,payload:JSON.stringify(payload)});});node.status({fill:'blue',text:'deploying '+devs.length+' devices'});msg.payload=results;return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":300,"y":1800,"wires":[["MQ_DEPLOY"]]},
