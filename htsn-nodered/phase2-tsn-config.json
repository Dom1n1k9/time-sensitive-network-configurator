  {"id":"FORM_TAS","type":"ui_form","z":"FLOWTAB","group":"GRP_TAS","order":0,"width":6,"height":0,"name":"tas form","label":"TAS schedule","topic":"tas_save","topicType":"str","submit":"Save TAS","cancel":"Reset","splitLayout":false,"className":"","options":[{"label":"Schedule name","type":"text","name":"name","value":"tas1"},{"label":"Cycle time (ns)","type":"number","name":"cycle_time_ns","value":"500000000"},{"label":"Deploy target","type":"text","name":"deploy_target","value":""},{"label":"GCL (gate:ns gate:ns ...)","type":"text","name":"gcl","value":"1:250000000 0:250000000"}],"x":100,"y":1480,"wires":[["FN_TAS"]]},
  {"id":"FN_TAS","type":"function","z":"FLOWTAB","name":"tas SQL","func":"var f=msg.payload||{};var n=f.name||'';if(!n){return null;}msg.query='INSERT OR REPLACE INTO tas_schedules(id,name,cycle_time_ns,deploy_target) VALUES(?,?,?,?)';msg.params=[n,n,parseInt(f.cycle_time_ns)||0,f.deploy_target||''];var gs=[];dur=[];(String(f.gcl||'')).trim().split(/\\s+/).forEach(function(p){var a=p.split(':');if(a.length===2){var s=parseInt(a[0],10),d=parseInt(a[1],10);if(!isNaN(s)&&!isNaN(d)){gs.push(s);dur.push(d);}}});msg._gcl=gs;msg._dur=dur;return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":300,"y":1480,"wires":[["SQL_TAS"]]},
  {"id":"SQL_TAS","type":"sqlite","z":"FLOWTAB","name":"write tas","operation":"insert","query":"{{msg.query}}","failOnErr":true,"database":"SQLCFG","x":480,"y":1480,"wires":[["FN_TASG"]]},
  {"id":"FN_TASG","type":"function","z":"FLOWTAB","name":"write gcl","func":"var n=msg._name||'';var gs=msg._gcl||[];var dur=msg._dur||[];if(!gs.length){return null;}msg.query='DELETE FROM gcl_entries WHERE schedule_id=?';msg.params=[n];return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":660,"y":1480,"wires":[["SQL_TASGD"]]},
