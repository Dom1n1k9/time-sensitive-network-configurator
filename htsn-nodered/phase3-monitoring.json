  {"id":"SQL_LAT","type":"sqlite","z":"FLOWTAB","name":"latency stats","operation":"query","query":"SELECT device_id, AVG(latency_ms) as avg_ms, MAX(latency_ms) as max_ms, COUNT(*) as n FROM latency_log WHERE ts > strftime('%s','now','-300 seconds') GROUP BY device_id","failOnErr":false,"database":"SQLCFG","x":280,"y":2640,"wires":[["FN_MET"]]},
