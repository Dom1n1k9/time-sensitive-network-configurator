  {"id":"SQL_RECL","type":"sqlite","z":"FLOWTAB","name":"read recordings","operation":"query","query":"SELECT device_id,path,recorded_at,detections FROM recordings ORDER BY recorded_at DESC LIMIT 30","failOnErr":false,"database":"SQLCFG","x":280,"y":2860,"wires":[["FN_RECL"]]},
  {"id":"FN_RECL","type":"function","z":"FLOWTAB","name":"fmt recordings","func":"var rows=(msg.payload||[]).map(function(r){var ts=r.recorded_at?new Date(r.recorded_at*1000).toLocaleString():'';var det='';try{det=(JSON.parse(r.detections||'[]')||[]).length+' det';}catch(e){det=r.detections||'';}return{dev:r.device_id||'',path:r.path||'',ts:ts,det:det};});return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":480,"y":2860,"wires":[["T_RECL"]]},
