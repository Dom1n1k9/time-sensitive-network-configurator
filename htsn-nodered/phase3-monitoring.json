  {"id":"SQL_SENSL","type":"sqlite","z":"FLOWTAB","name":"read sensors","operation":"query","query":"SELECT device_id,sensor_id,name,value,unit,last_update FROM sensors ORDER BY device_id,sensor_id","failOnErr":false,"database":"SQLCFG","x":280,"y":2780,"wires":[["FN_SENSL"]]},
  {"id":"FN_SENSL","type":"function","z":"FLOWTAB","name":"fmt sensors","func":"var rows=(msg.payload||[]).map(function(r){var age=r.last_update?Math.floor(Date.now()/1000-r.last_update)+'s':'?';return{dev:r.device_id||'',sid:r.sensor_id||'',name:r.name||r.sensor_id||'',val:(r.value||0).toFixed?String(Math.round(r.value*100)/100):String(r.value||''),unit:r.unit||'',age:age};});return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":480,"y":2780,"wires":[["T_SENSL"]]},
  {"id":"T_SENSL","type":"ui_table","z":"FLOWTAB","group":"GRP_SENS","name":"sensors","width":"12","height":"10","collapse":false,"tableLayout":"fixed","hoverable":true,"sortable":true,"storeFirstRows":false,"defaultSort":{"property":"dev","direction":"asc"},"columns":[{"alias":"device","property":"dev","type":"text","width":"15%","layout":"left"},{"alias":"sensor","property":"name","type":"text","width":"15%","layout":"left"},{"alias":"id","property":"sid","type":"text","width":"15%","layout":"left"},{"alias":"value","property":"val","type":"text","width":"15%","layout":"right"},{"alias":"unit","property":"unit","type":"text","width":"10%","layout":"left"},{"alias":"age","property":"age","type":"text","width":"10%","layout":"right"},{"alias":"id2","property":"sid","type":"text","width":"20%","layout":"left"}],"layout":"row","x":680,"y":2780,"wires":[]},

