  {"id":"SQL_PTPM","type":"sqlite","z":"FLOWTAB","name":"ptp stats","operation":"query","query":"SELECT device_id, AVG(offset_ns) as avg_off, MAX(jitter_ns) as max_jit, COUNT(*) as n FROM timesync_reports WHERE ts > strftime('%s','now','-300 seconds') GROUP BY device_id","failOnErr":false,"database":"SQLCFG","x":280,"y":2700,"wires":[["FN_PTPM"]]},
