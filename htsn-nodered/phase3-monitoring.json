  },
  {
    "id": "FN_EVT",
    "type": "function",
    "z": "FLOWTAB",
    "name": "fmt events",
    "func": "var rows=(msg.payload||[]).map(function(r){var ts=r.ts?new Date(r.ts*1000).toLocaleTimeString():'';return{ts:ts,kind:r.type||'',src:r.source||'',msg:r.line||''};});return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 480,
    "y": 2500,
    "wires": [
      [
        "T_EVT"
      ]
    ]
  },
  {
    "id": "T_EVT",
    "type": "ui_template",
    "z": "FLOWTAB",
    "group": "GRP_EVT",
    "name": "events",
    "width": "12",
    "height": "10",
    "x": 680,
    "y": 2500,
    "wires": [],
    "html": "<div style=\"overflow:auto;max-height:100%\">\n<table style=\"width:100%;border-collapse:collapse;font-size:12px\" id=\"tbl_{id}\">\n<thead><tr><th>time</th><th>kind</th><th>source</th><th>message</th></tr></thead>\n<tbody id=\"tbody_{id}\"></tbody>\n</table>\n</div>\n<script>\n(function(){\n  var tblId='tbl_{id}';\n  var cols=[\"ts\", \"kind\", \"src\", \"msg\"];\n  function render(){\n    var rows=(msg&&msg.payload)||[];\n    var tbody=document.getElementById('tbody_'+tblId);\n    if(!tbody)return;\n    tbody.innerHTML='';\n    rows.forEach(function(r){\n      var tr=document.createElement('tr');\n      tr.style.borderBottom='1px solid #eee';\n      cols.forEach(function(p){\n        var td=document.createElement('td');\n        td.style.padding='4px 6px';\n        var v=r[p];\n        td.textContent=(v===null||v===undefined)?'-':String(v);\n        tr.appendChild(td);\n      });\n      tbody.appendChild(tr);\n    });\n    if(rows.length===0){\n      var tr=document.createElement('tr');\n      var td=document.createElement('td');\n      td.colSpan=cols.length;\n      td.style.textAlign='center';\n      td.style.color='#999';\n      td.textContent='No data';\n      tr.appendChild(td);\n      tbody.appendChild(tr);\n    }\n  }\n  render();\n})();\n</script>",
    "format": "{{msg.payload}}",
    "storeOutMessages": true,
    "fgColor": "#000000",
    "bgColor": "#ffffff",
    "className": ""
  },
