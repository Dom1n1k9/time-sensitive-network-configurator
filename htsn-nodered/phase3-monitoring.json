  {"id":"SQL_EVT","type":"sqlite","z":"FLOWTAB","name":"read events","operation":"query","query":"SELECT ts,kind,source,msg FROM trace_log ORDER BY id DESC LIMIT 100","failOnErr":false,"database":"SQLCFG","x":280,"y":2500,"wires":[["FN_EVT"]]},
  {"id":"FN_EVT","type":"function","z":"FLOWTAB","name":"fmt events","func":"var rows=(msg.payload||[]).map(function(r){var ts=r.ts?new Date(r.ts*1000).toLocaleTimeString():'';return{ts:ts,kind:r.kind||'',src:r.source||'',msg:r.msg||''};});return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","x":480,"y":2500,"wires":[["T_EVT"]]},
