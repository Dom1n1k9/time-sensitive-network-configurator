[Unit]
Description=HTSN PTPv2 slave helper (Delay_Req + PDelay_Resp for Wireshark)
After=network-online.target htsn-ptp.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /home/wtsn/wtsn-configurator/rpi-tsn/htsn_ptp_slave.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.service
