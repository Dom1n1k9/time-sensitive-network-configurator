[Unit]
Description=HTSN virtual (software) TSN switch (isolated netns)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HTSN_DB=/home/wtsn/wtsn-configurator/build/htsn_gui.db
ExecStart=/usr/bin/python3 /home/wtsn/wtsn-configurator/rpi-tsn/htsn_vswitch.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
