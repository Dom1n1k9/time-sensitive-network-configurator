[Unit]
Description=HTSN AI Policy Engine (autonomous TSN decisions)
After=network-online.target mosquitto.service htsn-webgui.service
Wants=network-online.target mosquitto.service htsn-webgui.service

[Service]
EnvironmentFile=/etc/htsn/env
Type=simple
User=htsn
WorkingDirectory=/home/htsn/htsn-ai
ExecStart=/usr/bin/python3 /home/htsn/htsn-ai/policy_engine.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
