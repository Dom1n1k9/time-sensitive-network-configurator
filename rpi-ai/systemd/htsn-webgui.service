[Unit]
Description=HTSN Web GUI
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
EnvironmentFile=/etc/htsn/env
Type=simple
User=htsn
WorkingDirectory=/home/htsn/htsn-configurator
Environment=HTSN_BROKER=localhost:1883
ExecStart=/usr/bin/python3 /home/htsn/htsn-configurator/webgui.py --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
