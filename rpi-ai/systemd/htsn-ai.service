[Unit]
Description=HTSN AI Vision (YOLO detection on ESP32-CAM)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
EnvironmentFile=/etc/htsn/env
Type=simple
User=htsn
WorkingDirectory=/home/htsn/htsn-ai
ExecStart=/usr/bin/python3 /home/htsn/htsn-ai/vision_service.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
